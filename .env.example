# =================================================================
# APEX 24/7 Cloud Trading Engine & Vercel Dashboard Configurations
# =================================================================

# 1. Exchange Credentials (Binance USDS-M Perpetuals Testnet)
BINANCE_API_KEY=your_binance_testnet_api_key_here
BINANCE_API_SECRET=your_binance_testnet_api_secret_here
BINANCE_TESTNET=true

# 2. Polling & Execution Frequency
POLL_INTERVAL=5.0
PORT=8080

# 3. Telemetry Webhook (Optional: push state outbound to Vercel)
# Format: https://your-vercel-app-name.vercel.app/api/telemetry
VERCEL_WEBHOOK_URL=https://your-vercel-dashboard.vercel.app/api/telemetry
APEX_API_SECRET=apex_secure_random_token_12345

# 4. For Vercel Environment Variables:
# BOT_API_URL=https://your-railway-app-name.up.railway.app
# APEX_API_SECRET=apex_secure_random_token_12345
